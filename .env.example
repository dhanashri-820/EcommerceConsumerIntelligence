# ==============================================================================
# Ecommerce Consumer Intelligence - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Security & Authentication
# Generated random key for development. Always use a strong, unique secret in production!
JWT_SECRET_KEY=dev_insecure_secret_key_change_in_production_ecommerce_consumer_intel_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite database for persistent user management
DATABASE_PATH=data/auth.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Machine Learning Models Directory
MODELS_DIR=models
OUTPUTS_DIR=outputs
DATA_DIR=data
